# Bootstrap makefile for Qstit, so that a plain "make" in this folder is enough.
#
# The real build rules live in "Makefile", which is generated by qmake and is
# therefore not kept in the repository. GNU make reads "GNUmakefile" in
# preference to "Makefile", so this file runs qmake first and then hands every
# target over to the generated makefile.
#
# QMAKE can be overridden if the wanted Qt is not the first one on the PATH:
#     make QMAKE=/usr/lib64/qt6/bin/qmake

QMAKE ?= $(firstword $(foreach q,qmake6 qmake-qt6 qmake qmake-qt5,\
                       $(if $(shell command -v $(q) 2>/dev/null),$(q))))

ifeq ($(QMAKE),)
    $(error qmake was not found - install the Qt development packages \
            (Fedora: qt6-qtbase-devel, Debian/Ubuntu: qt6-base-dev) \
            or pass its path with "make QMAKE=/path/to/qmake")
endif

.DEFAULT_GOAL := all

# These are inputs, never things to rebuild. The empty rules keep make from
# trying to regenerate them through the catch-all rule at the bottom.
GNUmakefile qstit.pro: ;

.PHONY: all first qmake install uninstall clean check distclean

all first: qmake
	@$(MAKE) --no-print-directory -f Makefile

# Regenerate the qmake makefile only when it is missing or older than the
# project file. Done inside the recipe rather than as a dependency, so that
# "Makefile" stays out of the target graph.
qmake:
	@if [ ! -f Makefile ] || [ qstit.pro -nt Makefile ]; then \
	    echo "$(QMAKE) -o Makefile qstit.pro"; \
	    $(QMAKE) -o Makefile qstit.pro; \
	fi

install uninstall clean check: qmake
	@$(MAKE) --no-print-directory -f Makefile $@

# distclean deletes the generated makefile, so it cannot run through "qmake".
distclean:
	@if [ -f Makefile ]; then $(MAKE) --no-print-directory -f Makefile distclean; fi
	@rm -f .qmake.stash

# Anything else is a target of the generated makefile (e.g. a single object file).
%: qmake
	@$(MAKE) --no-print-directory -f Makefile $@
